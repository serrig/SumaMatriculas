# ────────────────────────────────────────────────────────────────────
# SumaMatrículas — variables de entorno
# ────────────────────────────────────────────────────────────────────
# Este archivo es la PLANTILLA (trackeado en git). NO contiene secretos
# reales. Copia a `.env` (gitignored) y rellena con tus valores.
#
#   cp .env.example .env
#
# Para generar secretos fuertes:
#   openssl rand -hex 32
# ────────────────────────────────────────────────────────────────────

# ── PostgreSQL — usuario MAESTRO (init del cluster, NO usado por la app) ─
# Este usuario se crea automáticamente al inicializar el cluster de Postgres.
# Solo se usa para crear APP_DB_USER en el primer arranque.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_generate_with_openssl_rand_hex_32
POSTGRES_DB=postgres

# ── PostgreSQL — usuario LIMITADO para la app ─────────────────────────
# Creado automáticamente en el primer arranque del cluster por
# db/init/01-create-app-user.sh. Solo tiene privilegios CRUD sobre las
# tablas; no puede crear usuarios, modificar el schema ni hacer DROP.
APP_DB_USER=suma_app
APP_DB_PASSWORD=CAMBIAR_generate_with_openssl_rand_hex_32_DISTINTO_DEL_MAESTRO

# Sesión — firma de cookies. CRÍTICO: nunca commitees el valor real.
SESSION_SECRET=CAMBIAR_generate_with_openssl_rand_hex_32

# Aplicación
APP_URL=http://localhost:4000
NG_ALLOWED_HOSTS=localhost,127.0.0.1

# Cookies seguras — true SOLO detrás de HTTPS (Cloudflare Tunnel,
# proxy reverso con TLS, etc.). En dev local déjalo en false.
COOKIE_SECURE=false

# Google OAuth (credenciales en https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizado en dev:    http://localhost:4000/api/auth/google/callback
# Redirect URI autorizado en prod:   https://tu-dominio.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server
PORT=4000
NODE_ENV=development