# PostgreSQL (base de datos local de desarrollo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Sesión
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Google OAuth (crear credenciales en https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizado: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET

# URL de la aplicación
APP_URL=http://localhost:4000
PORT=4000
