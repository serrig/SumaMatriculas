{
  "name": "suma-matriculas",
  "version": "0.0.0",
  "scripts": {
    "prestart": "node set-env.js",
    "prebuild": "node set-env.js",
    "ng": "ng",
    "start": "ng serve --port 4000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:suma-matriculas": "node dist/suma-matriculas/server/server.mjs",
    "dev": "ng serve --port 4000",
    "test:server": "vitest run --config vitest.server.config.mts",
    "test:all": "ng test --watch=false && npm run test:server",
    "docker:build:local": "docker build -t suma-matriculas-app:local .",
    "docker:build:amd64": "docker buildx build --platform linux/amd64 -t suma-matriculas-app:amd64 --load .",
    "docker:export:amd64": "npm run docker:build:amd64 && docker save suma-matriculas-app:amd64 | gzip > suma-amd64.tar.gz"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.22.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.17.19",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
